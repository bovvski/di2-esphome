wifi_ssid: "your-wifi"
wifi_password: "at-least-8-characters"
# Derailleur MAC: leave as is for the first flash, read it from the log ("RD seen: ... mac=..."), then replace.
di2_mac: "00:00:00:00:00:00"
# Generate: openssl rand -base64 32
api_key: "REPLACE_ME"
# Generate: openssl rand -hex 16
ota_password: "REPLACE_ME"
